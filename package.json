{
  "name": "dsh-antigravity-acp",
  "version": "0.4.0",
  "description": "Google Antigravity ACP Android native plugin with PRoot ARM64 patch, native OAuth loopback and DSH Go UI",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-antigravity-acp": "lib/cli.js"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "Antigravity",
      "en": "Antigravity"
    },
    "icon": "model",
    "contributes": {
      "composer.strip": [
        {
          "id": "acp-strip",
          "icon": "model",
          "panel": "acp-panel"
        }
      ],
      "panels": [
        {
          "id": "acp-panel",
          "title": {
            "zh": "Antigravity",
            "en": "Antigravity"
          },
          "icon": "model",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node ../dsh-go-repo/sdk/plugin-kit/bin/check.mjs . --load"
  }
}
