{
  "name": "dsh-antigravity-acp",
  "version": "0.4.0",
  "description": "Google Antigravity ACP Android native plugin with PRoot ARM64 patch, native OAuth loopback and DSH Go UI",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-antigravity-acp": "lib/cli.js"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "Antigravity",
      "en": "Antigravity"
    },
    "icon": "model",
    "contributes": {
      "composer.strip": [
        {
          "id": "acp-strip",
          "icon": "model",
          "panel": "acp-panel"
        }
      ],
      "panels": [
        {
          "id": "acp-panel",
          "title": {
            "zh": "Antigravity",
            "en": "Antigravity"
          },
          "icon": "model",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "node ../dsh-go-repo/sdk/plugin-kit/bin/check.mjs . --load"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || 4.0.5-alpha.1 || ~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subprocess-local": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@types/node": "^22.15.0",
    "@types/yauzl": "3.4.0",
    "typescript": "^5.9.3"
  }
}
